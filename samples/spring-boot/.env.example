# This is a shell environment file: set -a; . ./.env; set +a
# Supply registered TEST credentials. No real key or default login is included.
LUNIXI_MERCHANT_ID=''
LUNIXI_ENVIRONMENT='TEST'
LUNIXI_KEY_ID=''
# A single-quoted multiline PEM can contain actual newlines.
LUNIXI_PRIVATE_KEY=''
LUNIXI_WEBHOOK_SECRET=''
# Independent base64-encoded random 32-byte key; retain with private backups.
LUNIXI_STORAGE_KEY=''
LUNIXI_PUBLIC_BASE_URL='https://your-public-test-host.example'
LUNIXI_CHECKOUT_MODE='hosted'
LUNIXI_PREAUTH='false'
LUNIXI_LOCALE='en'
# Private H2 file outside the web root. Set different credentials explicitly.
LUNIXI_JDBC_URL='jdbc:h2:file:./data/lunixi;DB_CLOSE_ON_EXIT=FALSE'
LUNIXI_JDBC_USER=''
LUNIXI_JDBC_PASSWORD=''
# Set true only for first initialization of an isolated TEST database, then false.
LUNIXI_INITIALIZE_DISPOSABLE='false'
DEMO_ALICE_PASSWORD=''
DEMO_BOB_PASSWORD=''
# ONLY for loopback development HTTP; production default is true.
LUNIXI_SECURE_COOKIES='false'
SERVER_ADDRESS='127.0.0.1'
SERVER_PORT='8080'
